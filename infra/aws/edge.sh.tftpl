#!/bin/bash
set -euo pipefail

dnf install -y nginx unzip policycoreutils-python-utils nftables
curl -fsSL -o /tmp/awscliv2.zip https://awscli.amazonaws.com/awscli-exe-linux-aarch64-2.39.6.zip
unzip -q -o /tmp/awscliv2.zip -d /tmp
/tmp/aws/install --update
curl -fsSL -o /tmp/cloudflared.rpm https://github.com/cloudflare/cloudflared/releases/download/2026.10.7/cloudflared-linux-aarch64.rpm
dnf install -y /tmp/cloudflared.rpm

param() {
    aws ssm get-parameter --region ${region} --name ${ssm_prefix}/$1 --with-decryption --query Parameter.Value --output text
}

mkdir -p /var/www/sesume

cat > /usr/local/bin/sesume-dist-sync <<'SYNC'
#!/bin/bash
set -euo pipefail
aws s3 sync s3://${bucket}/ /var/www/sesume --region ${region} --delete
chcon -R -t httpd_sys_content_t /var/www/sesume
SYNC
chmod +x /usr/local/bin/sesume-dist-sync

cat > /etc/systemd/system/sesume-dist-sync.service <<'UNIT'
[Unit]
Description=Sync the built frontend from S3
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/sesume-dist-sync
UNIT

cat > /etc/systemd/system/sesume-dist-sync.timer <<'UNIT'
[Unit]
Description=Pick up a frontend deploy without a reboot

[Timer]
OnBootSec=60
OnUnitActiveSec=300

[Install]
WantedBy=timers.target
UNIT

printf 'proxy_set_header X-Origin-Token %s;\n' "$(param origin_token)" > /etc/nginx/sesume-origin.conf

cat > /etc/nginx/conf.d/sesume.conf <<'CONF'
server {
    listen 127.0.0.1:8080;
    server_name ${domain};

    root /var/www/sesume;
    index index.html;
    absolute_redirect off;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types application/javascript text/css application/json image/svg+xml;

    location ^~ /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-store" always;
    }

    location /api/ {
        proxy_pass https://${function_host};
        proxy_http_version 1.1;
        proxy_set_header X-Forwarded-For $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 70s;
        include /etc/nginx/sesume-origin.conf;
    }

    location / {
        try_files $uri /index.html;
    }
}
CONF

semanage port -a -t http_port_t -p tcp 8080 2>/dev/null || true
setsebool -P httpd_can_network_connect 1

systemctl enable --now sesume-dist-sync.timer
/usr/local/bin/sesume-dist-sync
systemctl enable --now nginx

cloudflared service install "$(param tunnel_token)"
systemctl enable --now cloudflared

cat > /etc/sysctl.d/99-sesume-nat.conf <<'SYSCTL'
net.ipv4.ip_forward = 1
SYSCTL
sysctl -q --system

cat > /usr/local/bin/sesume-nat <<'NAT'
#!/bin/bash
set -euo pipefail
nft add table ip sesume 2>/dev/null || true
nft add chain ip sesume post '{ type nat hook postrouting priority srcnat; }' 2>/dev/null || true
nft flush chain ip sesume post
nft add rule ip sesume post ip saddr ${vpc_cidr} masquerade
NAT
chmod +x /usr/local/bin/sesume-nat

cat > /etc/systemd/system/sesume-nat.service <<'UNIT'
[Unit]
Description=NAT for the private subnets
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/sesume-nat

[Install]
WantedBy=multi-user.target
UNIT

systemctl enable --now sesume-nat.service
